# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
AEVUM_ENV=development
AEVUM_LOG_LEVEL=info

# Database
DATABASE_URL=postgres://aevum:aevum_dev_password@localhost:5432/aevum_identity

# Redis
REDIS_URL=redis://localhost:6379

# MinIO / Object Storage
MINIO_ENDPOINT=http://localhost:9000
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=aevum
MINIO_SECRET_KEY=aevum_dev_only
MINIO_AUDIT_BUCKET=aevum-audit
MINIO_MEDIA_BUCKET=aevum-media
MINIO_USE_SSL=false

# Security & Secrets
AEVUM_MASTER_KEK=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
AEVUM_JWT_SECRET=super-secret-jwt-key-minimum-32-chars-long!
AEVUM_SESSION_SECRET=super-secret-session-key-minimum-32-chars!

# OAuth (v1 Providers)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

