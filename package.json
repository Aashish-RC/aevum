{
  "name": "aevum",
  "version": "0.1.0",
  "private": true,
  "description": "Aevum AI Core Platform",
  "license": "MIT",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=@aevum/api",
    "test": "vitest run",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "db:generate": "pnpm --filter=@aevum/db generate",
    "db:migrate": "pnpm --filter=@aevum/db migrate"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "turbo": "^2.4.4",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@biomejs/biome", "esbuild"]
  },
  "packageManager": "pnpm@10.30.3"
}
